        <div class="post-title">${p.link ? `<a href=" ">${esc(p.title)}</a >` : esc(p.title)}</div>
        <div class="post-date">${esc(p.date)}</div>
      </div>`).join('')
  : `<p class="muted">暂无文章。</p >`;
 
/* 联系 */
const C = D.contact;
document.getElementById('contactBox').innerHTML = `
  <div class="contact-list">
    ${D.profile.email ? `<div>邮箱：<b>${esc(D.profile.email)}</b></div>` : ''}
    ${D.profile.phone ? `<div>电话：<b>${esc(D.profile.phone)}</b></div>` : ''}
    ${D.profile.city  ? `<div>城市：<b>${esc(D.profile.city)}</b></div>`  : ''}
  </div>
  <div style="margin-top:22px">
    ${C.links.filter(l => l.url).map(l => `<a href="${l.url}" target="_blank" rel="noopener" style="margin-right:22px">${esc(l.label)} ↗</a >`).join('')}
  </div>
  <p class="muted" style="margin-top:22px">${esc(C.hobby)}</p >`;
document.getElementById('footer').textContent = D.profile.footer;
 
 
/* === 动效逻辑 === */
(function(){
  /* --- 1. 自动给各板块打上淡入标记 --- */
  const revealTargets = [
    '#hero > div', '#aboutBox .card', '#worksGrid .work',
    '#expBox .card', '#skillsBox .card', '#blogBox', '#contactBox'
  ];
  revealTargets.forEach(sel=>{
    document.querySelectorAll(sel).forEach((el,i)=>{
      el.classList.add('reveal');
      el.classList.add('d' + (i % 4 + 1));
    });
  });
 
  /* --- 2. 进入视口时浮现，只触发一次 --- */
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.classList.add('is-visible');
        // 技能条：进入视口时才生长到设定宽度
        e.target.querySelectorAll('.skill-fill').forEach(bar=>{
          const w = bar.dataset.level;
          if(w) setTimeout(()=>{ bar.style.width = w + '%'; }, 200);
        });
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
 
  /* --- 3. 导航滚动收缩 --- */
  const nav = document.querySelector('nav');
  let ticking = false;
  window.addEventListener('scroll', ()=>{
    if(ticking) return;
    ticking = true;
    requestAnimationFrame(()=>{
      nav.classList.toggle('scrolled', window.scrollY > 40);
      ticking = false;
    });
  }, { passive:true });
 
  /* --- 4. 鼠标柔光跟随（触屏设备自动跳过）--- */
  if(window.matchMedia('(hover:hover)').matches){
    const glow = document.createElement('div');
    glow.className = 'cursor-glow';
    document.body.appendChild(glow);
    let gx=0, gy=0, cx=0, cy=0;
    window.addEventListener('mousemove', e=>{
      gx=e.clientX; gy=e.clientY; glow.style.opacity='1';
    }, { passive:true });
    (function loop(){
      cx += (gx-cx)*0.08;
      cy += (gy-cy)*0.08;
      glow.style.left = cx+'px';
      glow.style.top  = cy+'px';
      requestAnimationFrame(loop);
    })();
  }
})();
</script>
