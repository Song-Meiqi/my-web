<style>
/* === 莫奈色板（改这里可整体换色调）=== */
:root{
  --cream:      #F7F3EC;
  --mist:       #EDF0EE;
  --wisteria:   #C9BFDB;
  --lavender:   #A99BC4;
  --pond:       #7FA895;
  --deep-green: #5C8B78;
  --sky:        #A8C0D6;
  --rose:       #E5C6CC;
  --ink:        #4A4A52;
  --ink-soft:   #7C7B85;
  --line:       #E0DAD2;
  --radius:     22px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Noto Serif SC',serif;
  color:var(--ink);
  background:
    radial-gradient(1200px 600px at 15% 0%, rgba(201,191,219,.38), transparent 60%),
    radial-gradient(900px 500px at 85% 20%, rgba(168,192,214,.35), transparent 60%),
    radial-gradient(1000px 700px at 50% 100%, rgba(127,168,149,.22), transparent 65%),
    var(--cream);
  background-attachment:fixed;
  line-height:1.9;
  font-size:16px;
}
h1,h2,h3{font-family:'Cormorant Garamond','Noto Serif SC',serif;font-weight:500;letter-spacing:.02em}
a{color:var(--deep-green);text-decoration:none;border-bottom:1px solid rgba(92,139,120,.3)}
a:hover{color:var(--lavender);border-color:var(--lavender)}
 
/* === 导航 === */
nav{
  position:sticky;top:0;z-index:99;
  backdrop-filter:blur(14px);
  background:rgba(247,243,236,.78);
  border-bottom:1px solid var(--line);
}
.nav-inner{max-width:1080px;margin:0 auto;padding:16px 24px;
  display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:.12em}
.nav-links{display:flex;flex-wrap:wrap;gap:20px;font-size:14.5px}
.nav-links a{border:none;color:var(--ink-soft)}
.nav-links a:hover{color:var(--deep-green)}
 
/* === 区块通用 === */
section{max-width:1080px;margin:0 auto;padding:84px 24px}
.sec-title{font-size:34px;margin-bottom:8px}
.sec-title em{font-style:italic;color:var(--lavender)}
.sec-sub{font-size:13px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--ink-soft);margin-bottom:42px}
.card{
  background:rgba(255,255,255,.58);
  border:1px solid rgba(255,255,255,.9);
  border-radius:var(--radius);
  padding:30px 32px;
  box-shadow:0 18px 48px rgba(120,120,140,.07);
  backdrop-filter:blur(6px);
  margin-bottom:22px;
}
.muted{color:var(--ink-soft);font-size:14.5px}
.tag{
  display:inline-block;padding:5px 14px;margin:4px 6px 4px 0;
  border-radius:999px;font-size:13.5px;
  background:rgba(168,192,214,.22);
  border:1px solid rgba(168,192,214,.45);
  color:#4A5A6B;
}
.tag.g{background:rgba(127,168,149,.2);border-color:rgba(127,168,149,.45);color:#3E6555}
.tag.p{background:rgba(201,191,219,.28);border-color:rgba(201,191,219,.55);color:#5F5279}
 
/* === 首页头部 === */
#hero{display:flex;gap:48px;align-items:center;flex-wrap:wrap;padding-top:110px}
.hero-photo{
  width:210px;height:210px;flex:0 0 auto;border-radius:50%;
  object-fit:cover;
  border:6px solid rgba(255,255,255,.85);
  box-shadow:0 20px 50px rgba(140,130,160,.22);
  background:linear-gradient(135deg,var(--wisteria),var(--sky));
}
.hero-photo.placeholder{display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:13px;letter-spacing:.1em;text-align:center}
.hero-name{font-size:52px;line-height:1.15}
.hero-tagline{font-size:17px;color:var(--ink-soft);margin:10px 0 6px}
.hero-target{font-size:15px;color:var(--deep-green);margin-bottom:22px}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 26px;font-size:14.5px;color:var(--ink-soft)}
.hero-meta span::before{content:"· ";color:var(--pond)}
 
/* === 时间线 === */
.timeline{position:relative;padding-left:26px}
.timeline::before{content:"";position:absolute;left:5px;top:8px;bottom:8px;width:1.5px;
  background:linear-gradient(var(--wisteria),var(--pond),transparent)}
.tl-item{position:relative;margin-bottom:34px}
.tl-item:last-child{margin-bottom:0}
.tl-item::before{content:"";position:absolute;left:-25px;top:11px;
  width:9px;height:9px;border-radius:50%;background:var(--pond);
  box-shadow:0 0 0 4px rgba(127,168,149,.16)}
.tl-head{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;align-items:baseline}
.tl-title{font-size:19px}
.tl-time{font-size:13.5px;color:var(--ink-soft);font-style:italic}
 
/* === 作品集 === */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:24px}
.work{background:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.9);
  border-radius:var(--radius);overflow:hidden;
  box-shadow:0 16px 40px rgba(120,120,140,.07)}
.work-img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;
  background:linear-gradient(135deg,var(--mist),var(--wisteria),var(--sky))}
.work-body{padding:22px 24px 26px}
.work-title{font-size:20px;margin-bottom:4px}
.work-time{font-size:13px;color:var(--ink-soft);font-style:italic;margin-bottom:12px}
.work-role{font-size:13.5px;color:var(--deep-green);margin-bottom:10px}
.work-desc{font-size:14.5px;color:var(--ink-soft);margin-bottom:14px}
 
/* === 技能 === */
.skill-row{display:flex;align-items:center;gap:16px;margin-bottom:14px}
.skill-label{flex:0 0 130px;font-size:14.5px}
.skill-bar{flex:1;height:7px;border-radius:99px;background:rgba(201,191,219,.3);overflow:hidden}
.skill-fill{height:100%;border-radius:99px;
  background:linear-gradient(90deg,var(--wisteria),var(--pond))}
 
/* === 博客 === */
.post{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
  padding:18px 0;border-bottom:1px solid var(--line)}
.post:last-child{border-bottom:none}
.post-title{font-size:17px}
.post-date{font-size:13.5px;color:var(--ink-soft);font-style:italic}
 
/* === 联系 === */
.contact-list{display:flex;flex-wrap:wrap;gap:14px 40px;font-size:15.5px}
.contact-list div{color:var(--ink-soft)}
.contact-list b{color:var(--ink);font-weight:400}
 
footer{text-align:center;padding:60px 24px 80px;font-size:13.5px;color:var(--ink-soft)}
 
/* === 交互动效层 === */
/* 1. 滚动淡入 */
.reveal{
  opacity:0;
  transform:translateY(34px);
  transition:opacity .9s cubic-bezier(.22,.61,.36,1),
             transform .9s cubic-bezier(.22,.61,.36,1);
  will-change:opacity,transform;
}
.reveal.is-visible{opacity:1;transform:translateY(0)}
.reveal.d1{transition-delay:.10s}
.reveal.d2{transition-delay:.20s}
.reveal.d3{transition-delay:.30s}
.reveal.d4{transition-delay:.40s}
 
/* 2. 导航滚动收缩 */
nav{transition:padding .45s ease, background .45s ease, box-shadow .45s ease}
nav.scrolled{background:rgba(247,243,236,.62);box-shadow:0 6px 26px rgba(120,120,140,.07)}
nav.scrolled .nav-inner{padding-top:10px;padding-bottom:10px}

/* 3. 背景光斑呼吸 */
body::before{
  content:"";position:fixed;inset:-20%;z-index:-1;pointer-events:none;
  background:
    radial-gradient(38% 32% at 22% 28%, rgba(201,191,219,.30), transparent 70%),
    radial-gradient(34% 30% at 78% 22%, rgba(168,192,214,.28), transparent 70%),
    radial-gradient(42% 36% at 58% 76%, rgba(127,168,149,.20), transparent 72%);
  animation:breathe 22s ease-in-out infinite alternate;
}
@keyframes breathe{
  0%  {opacity:.65; transform:scale(1)    translate(0,0)}
  50% {opacity:.95; transform:scale(1.06) translate(1.5%,-1.5%)}
  100%{opacity:.75; transform:scale(1.02) translate(-1.5%,1.5%)}
}
 
/* 4. 鼠标柔光跟随 */
.cursor-glow{
  position:fixed;width:340px;height:340px;border-radius:50%;
  pointer-events:none;z-index:0;
  background:radial-gradient(circle, rgba(201,191,219,.20), transparent 68%);
  transform:translate(-50%,-50%);
  transition:opacity .5s ease;opacity:0;
  mix-blend-mode:multiply;
}
 
/* 5. 卡片悬停柔化 */
.card,.work{transition:transform .5s cubic-bezier(.22,.61,.36,1),
                       box-shadow .5s cubic-bezier(.22,.61,.36,1)}
.card:hover{transform:translateY(-3px);box-shadow:0 24px 56px rgba(120,120,140,.11)}
 
/* 6. 技能条初始宽度为 0，进入视口后生长 */
.skill-fill{width:0;transition:width 1.3s cubic-bezier(.22,.61,.36,1)}
 
/* 7. 尊重系统"减少动态效果"设置 */
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1!important;transform:none!important;transition:none!important}
  body::before{animation:none!important}
  .cursor-glow{display:none}
  .card:hover{transform:none}
  .skill-fill{transition:none!important}
}
 
/* === 手机端 === */
@media(max-width:680px){
  section{padding:60px 20px}
  #hero{flex-direction:column;text-align:center;gap:28px;padding-top:70px}
